#!/usr/bin/env python3
"""Make TikTok-style (1080x1920) videos from free Pixabay or Pexels footage + your music.
Run:  python make_video.py --count 3            (needs PIXABAY_API_KEY or PEXELS_API_KEY)
Test: python make_video.py --local some_clips/  (no internet, uses your own clips)
"""
import argparse, datetime, json, os, random, re, subprocess, sys, tempfile, textwrap
from pathlib import Path

ROOT = Path(__file__).resolve().parent
OUT = ROOT / "out"
MUSIC = ROOT / "music"
USED = ROOT / "used.json"
FONTS = ["/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
         "/usr/share/fonts/dejavu/DejaVuSans-Bold.ttf",
         "/System/Library/Fonts/Supplemental/Arial Bold.ttf",
         "C:/Windows/Fonts/arialbd.ttf"]


def run(cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        print("FFmpeg error:\n" + r.stderr[-2500:], file=sys.stderr)
        raise RuntimeError("command failed: " + " ".join(cmd[:3]))
    return r.stdout


def probe(path):
    out = run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(path)])
    return float(out.strip())


def pick_file(video, W=1080, H=1920):
    """Choose the best mp4 file of one Pexels video: portrait, about 1080x1920 (not 4K)."""
    files = [f for f in video.get("video_files", []) if f.get("file_type") == "video/mp4" and f.get("link")]
    if not files:
        return None
    portrait = [f for f in files if (f.get("height") or 0) > (f.get("width") or 0)]
    pool = portrait or files
    good = [f for f in pool if (f.get("height") or 0) >= 1080 or (f.get("width") or 0) >= 1080]
    pool = good or pool
    return min(pool, key=lambda f: abs((f.get("height") or 0) - H) + abs((f.get("width") or 0) - W) * 0.3)


def pexels_search(query, key, page):
    import requests
    r = requests.get("https://api.pexels.com/videos/search", headers={"Authorization": key},
                     params={"query": query, "orientation": "portrait", "size": "medium", "per_page": 40, "page": page},
                     timeout=40)
    if r.status_code == 401:
        sys.exit("Pexels key galat hai. PEXELS_API_KEY secret dobara check karein.")
    r.raise_for_status()
    return r.json().get("videos", [])


def pixabay_search(query, key, page):
    import requests
    r = requests.get("https://pixabay.com/api/videos/",
                     params={"key": key, "q": query[:100], "video_type": "film", "per_page": 40, "page": page,
                             "safesearch": "true"}, timeout=40)
    if r.status_code in (400, 401, 403):
        sys.exit("Pixabay key galat hai ya limit poori hai: " + r.text[:120])
    r.raise_for_status()
    return r.json().get("hits", [])


def pixabay_file(hit):
    """Best Pixabay file: 'large' (about 1080p), else medium."""
    vids = hit.get("videos", {})
    for k in ("large", "medium", "small"):
        f = vids.get(k) or {}
        if f.get("url"):
            return {"link": f["url"], "width": f.get("width", 0), "height": f.get("height", 0)}
    return None


def download(url, dst):
    import requests
    with requests.get(url, stream=True, timeout=120) as r:
        r.raise_for_status()
        with open(dst, "wb") as f:
            for chunk in r.iter_content(1 << 20):
                f.write(chunk)


def load_used():
    try:
        return set(json.loads(USED.read_text()).get("ids", []))
    except Exception:
        return set()


def save_used(ids):
    USED.write_text(json.dumps({"ids": sorted(ids)[-4000:]}))


def make_segment(src, dst, length, W, H, fps, blur_mode=False):
    dur = probe(src)
    length = min(length, dur - 0.1)
    if length < 1.5:
        return False
    start = random.uniform(0, max(0.0, dur - length - 0.1))
    crop = f"scale={W}:{H}:force_original_aspect_ratio=increase,crop={W}:{H},fps={fps},setsar=1,format=yuv420p"
    cmd = ["ffmpeg", "-y", "-ss", f"{start:.2f}", "-i", str(src), "-t", f"{length:.2f}"]
    if blur_mode and is_landscape(src):
        fc = (f"[0:v]split[a][b];[a]scale={W}:{H}:force_original_aspect_ratio=increase,crop={W}:{H},boxblur=40:6[bg];"
              f"[b]scale={W}:-2[fg];[bg][fg]overlay=(W-w)/2:(H-h)/2,fps={fps},setsar=1,format=yuv420p[v]")
        cmd += ["-filter_complex", fc, "-map", "[v]"]
    else:
        cmd += ["-vf", crop]
    run(cmd + ["-an", "-c:v", "libx264", "-preset", "veryfast", "-crf", "20", str(dst)])
    return True


def is_landscape(path):
    out = run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height",
               "-of", "csv=p=0", str(path)]).strip().split(",")
    return int(out[0]) > int(out[1])


def music_track(total, tmp):
    files = [p for p in MUSIC.glob("*") if p.suffix.lower() in (".mp3", ".wav", ".m4a", ".ogg", ".aac", ".flac")]
    if files:
        return random.choice(files)
    print("WARNING: music/ folder khali hai. Placeholder dhun bana raha hoon. Apni royalty-free music daalein!")
    pad = Path(tmp) / "pad.wav"
    run(["ffmpeg", "-y", "-f", "lavfi", "-i", "sine=frequency=220:sample_rate=44100", "-f", "lavfi", "-i", "sine=frequency=277.18",
         "-f", "lavfi", "-i", "sine=frequency=329.63", "-filter_complex",
         "amix=inputs=3:normalize=0,volume=0.25,tremolo=f=0.4:d=0.4,lowpass=f=900", "-t", f"{total + 2:.1f}", str(pad)])
    return pad


def build_video(sources, topic, cfg, idx, tmp):
    W, H, fps = cfg["width"], cfg["height"], cfg["fps"]
    segs, total = [], 0.0
    for n, src in enumerate(sources):
        length = random.uniform(cfg["clip_seconds_min"], cfg["clip_seconds_max"])
        seg = Path(tmp) / f"seg{idx}_{n}.mp4"
        if make_segment(src, seg, length, W, H, fps, cfg.get("landscape_mode") == "blur"):
            segs.append(seg)
            total += probe(seg)
    if len(segs) < 2:
        raise RuntimeError("Kafi clips nahi mili")
    lst = Path(tmp) / f"list{idx}.txt"
    lst.write_text("".join(f"file '{s.as_posix()}'\n" for s in segs))
    joined = Path(tmp) / f"joined{idx}.mp4"
    run(["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", str(lst), "-c", "copy", str(joined)])
    D = probe(joined)
    vf = f"[0:v]fade=t=in:st=0:d=0.4,fade=t=out:st={D - 0.5:.2f}:d=0.5"
    font = next((f for f in FONTS if Path(f).exists()), None)
    if cfg.get("show_title") and font:
        tf = Path(tmp) / f"title{idx}.txt"
        tf.write_text("\n".join(textwrap.wrap(topic["title"], 18)))
        alpha = "if(lt(t,0.4),0,if(lt(t,0.9),(t-0.4)/0.5,if(lt(t,3.1),1,if(lt(t,3.6),(3.6-t)/0.5,0))))"
        vf += (f",drawtext=fontfile='{font}':textfile='{tf.as_posix()}':fontsize=78:fontcolor=white:"
               f"borderw=4:bordercolor=black@0.6:x=(w-text_w)/2:y=h*0.17:alpha='{alpha}'")
    vf += "[v]"
    af = f"[1:a]afade=t=in:st=0:d=1,afade=t=out:st={max(D - 2, 0):.2f}:d=2,volume={cfg['music_volume']}[a]"
    mus = music_track(D, tmp)
    mdur = probe(mus)
    mstart = random.uniform(0, mdur - D - 1) if mdur > D + 6 else 0
    slug = re.sub(r"[^a-z0-9]+", "-", topic["title"].lower()).strip("-")
    name = f"{datetime.date.today():%Y-%m-%d}-{slug}-{idx + 1}-{random.randint(100, 999)}"
    OUT.mkdir(exist_ok=True)
    out = OUT / f"{name}.mp4"
    run(["ffmpeg", "-y", "-i", str(joined), "-stream_loop", "-1", "-ss", f"{mstart:.1f}", "-i", str(mus),
         "-filter_complex", vf + ";" + af, "-map", "[v]", "-map", "[a]", "-t", f"{D:.2f}",
         "-c:v", "libx264", "-preset", "medium", "-crf", "20", "-pix_fmt", "yuv420p",
         "-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart", str(out)])
    (OUT / f"{name}.txt").write_text(f"{topic['title']}\n\n{topic.get('hashtags', '')}\n")
    print(f"OK  {out.name}  {D:.0f}s  {out.stat().st_size / 1e6:.1f} MB")
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--count", type=int, default=0)
    ap.add_argument("--topic", default="")
    ap.add_argument("--local", default="", help="folder of your own clips (test mode, no internet)")
    a = ap.parse_args()
    cfg = json.loads((ROOT / "config.json").read_text(encoding="utf-8"))
    count = a.count or cfg["videos_per_run"]
    pex_key = os.environ.get("PEXELS_API_KEY", "")
    pix_key = os.environ.get("PIXABAY_API_KEY", "")
    if not a.local and not (pex_key or pix_key):
        sys.exit("PIXABAY_API_KEY ya PEXELS_API_KEY nahi mili. Settings > Secrets mein daalein.")
    used = load_used()
    made = 0
    with tempfile.TemporaryDirectory() as tmp:
        for i in range(count):
            topic = random.choice(cfg["topics"])
            if a.topic:
                hit = [t for t in cfg["topics"] if a.topic.lower() in (t["query"] + " " + t["title"]).lower()]
                topic = hit[0] if hit else {"query": a.topic, "title": a.topic.title(), "hashtags": "#fyp"}
            print(f"[{i + 1}/{count}] topic: {topic['query']}")
            try:
                srcs, ids = [], []
                if a.local:
                    pool = sorted(Path(a.local).glob("*.mp4"))
                    srcs = random.sample(pool, min(cfg["clips_per_video"], len(pool)))
                elif pix_key:
                    hits = pixabay_search(topic["query"], pix_key, random.randint(1, 2)) or pixabay_search(topic["query"], pix_key, 1)
                    fresh = [v for v in hits if f"pb{v['id']}" not in used] or hits
                    random.shuffle(fresh)
                    for v in fresh[:cfg["clips_per_video"] + 4]:
                        f = pixabay_file(v)
                        if not f:
                            continue
                        dst = Path(tmp) / f"dl{v['id']}.mp4"
                        download(f["link"], dst)
                        srcs.append(dst)
                        ids.append(f"pb{v['id']}")
                        if len(srcs) >= cfg["clips_per_video"]:
                            break
                else:
                    vids = pexels_search(topic["query"], pex_key, random.randint(1, 3)) or pexels_search(topic["query"], pex_key, 1)
                    fresh = [v for v in vids if f"px{v['id']}" not in used] or vids
                    random.shuffle(fresh)
                    for v in fresh[:cfg["clips_per_video"] + 4]:
                        f = pick_file(v, cfg["width"], cfg["height"])
                        if not f:
                            continue
                        dst = Path(tmp) / f"dl{v['id']}.mp4"
                        download(f["link"], dst)
                        srcs.append(dst)
                        ids.append(f"px{v['id']}")
                        if len(srcs) >= cfg["clips_per_video"]:
                            break
                build_video(srcs, topic, cfg, i, tmp)
                used.update(ids)
                made += 1
            except Exception as e:
                print(f"SKIP video {i + 1}: {e}", file=sys.stderr)
    if not a.local:
        save_used(used)
    print(f"Done: {made}/{count} videos in {OUT}")
    if made == 0:
        sys.exit(1)


if __name__ == "__main__":
    main()
